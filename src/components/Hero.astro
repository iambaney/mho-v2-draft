---
import Stars from './Stars.astro';
import Text from './Text.astro';
import { withBase } from '../lib/url';
import { splitLead } from '../lib/text';
interface Props {
  eyebrow: string; headline: string; subhead: string;
  primary_cta: { label: string; href: string };
  secondary_cta: { label: string; href: string };
  review_line: string; image: string; image_alt: string;
  edit?: boolean;
}
const { eyebrow, headline, subhead, primary_cta, secondary_cta, review_line, image, image_alt, edit = false } = Astro.props;
const [count, rest] = splitLead(review_line);
const A = edit ? 'span' : 'a';
---
<div class="hero">
  <div class="hero-img"><img alt={image_alt} class="warm" src={withBase(image)} /></div>
  <div class="scrim"></div>
  <div class="hero-in">
    <p class="eyebrow"><Text k="hero.eyebrow" v={eyebrow} edit={edit} /></p>
    <h1><Text k="hero.headline" v={headline} edit={edit} /></h1>
    <p class="sub"><Text k="hero.subhead" v={subhead} edit={edit} /></p>
    <div class="ctas">
      <A class="btn" href={edit ? undefined : withBase(primary_cta.href)}><Text k="hero.primary_cta.label" v={primary_cta.label} edit={edit} /></A>
      <A class="btn-ghost" href={edit ? undefined : withBase(secondary_cta.href)}><Text k="hero.secondary_cta.label" v={secondary_cta.label} edit={edit} /></A>
    </div>
    <p class="revline on-dark">
      <Stars label="Five out of five stars" />
      {edit ? <Text k="hero.review_line" v={review_line} edit /> : <span><b>{count}</b>{' ' + rest}</span>}
    </p>
  </div>
</div>
