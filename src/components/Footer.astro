---
import Text from './Text.astro';
interface Props { line_1: string; line_2: string; edit?: boolean }
const { line_1, line_2, edit = false } = Astro.props;
---
<div class="foot"><span><Text k="footer.line_1" v={line_1} edit={edit} /></span><span><Text k="footer.line_2" v={line_2} edit={edit} /></span></div>
