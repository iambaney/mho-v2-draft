---
import Stars from './Stars.astro';
import Text from './Text.astro';
interface Props { value: string; label: string; stars?: boolean; k: string; edit?: boolean }
const { value, label, stars = false, k, edit = false } = Astro.props;
---
<div class:list={['stat', { 'rev-stat': stars }]}>
  {stars && <Stars small />}
  <b><Text k={`${k}.value`} v={value} edit={edit} /></b>
  <span><Text k={`${k}.label`} v={label} edit={edit} /></span>
</div>
