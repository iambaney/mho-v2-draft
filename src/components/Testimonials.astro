---
import Stars from './Stars.astro';
import TestimonialCard from './TestimonialCard.astro';
import { splitLead } from '../lib/text';
interface Props {
  heading: string; count_line: string;
  items: { pullquote: string; body: string; attribution: string }[];
}
const { heading, count_line, items } = Astro.props;
const [count, rest] = splitLead(count_line);
---
<div class="tsec">
  <div class="tsec-h">
    <h2>{heading}</h2>
    <span class="rev"><Stars label="Five out of five stars" /><b>{count}</b>{' ' + rest}</span>
  </div>
  <div class="trow">
    {items.map((t) => <TestimonialCard {...t} />)}
  </div>
</div>
